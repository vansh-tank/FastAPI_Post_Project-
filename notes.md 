@app.get('/posts/orm', status_code=status.HTTP_200_OK)
def get_posts_orm(db: session = Depends(get_db)):
    posts = db.query(models.Post).all()
    return {'posts': posts}

def get_db():
    db = session()
    try:
        yield db
    finally: 
        db.close()

